{
  "name": "andersundsehr/frontend_studio",
  "description": "Frontend Studio - Build, test, and document frontend components in a project-specific styleguide.",
  "license": "GPL-2.0-or-later",
  "type": "typo3-cms-extension",
  "authors": [
    {
      "name": "Matthias Vogel",
      "email": "m.vogel@andersundsehr.com"
    }
  ],
  "require": {
    "php": "~8.4.0 || ~8.5.0",
    "typo3/cms-core": "^14.3.0",
    "typo3/cms-frontend": "^14.3.0",
    "typo3/cms-rte-ckeditor": "^14.3.0"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.44",
    "phpstan/phpstan": "^2.1.25",
    "phpunit/phpunit": "^11.2.5",
    "pluswerk/grumphp-config": "^11.1",
    "saschaegerer/phpstan-typo3": "^2.0.0 || ^3.0.1",
    "ssch/typo3-rector": "^3.1.0",
    "typo3/testing-framework": "^9.7"
  },
  "autoload": {
    "psr-4": {
      "Andersundsehr\\FrontendStudio\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Andersundsehr\\FrontendStudio\\Tests\\": "Tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "a9f/fractor-extension-installer": true,
      "ergebnis/composer-normalize": true,
      "phpro/grumphp": true,
      "phpstan/extension-installer": true,
      "pluswerk/grumphp-config": true,
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "frontend_studio"
    }
  },
  "scripts": {
    "post-update-cmd": [
      "@composer normalize"
    ],
    "test:unit": "vendor/bin/phpunit --configuration Build/phpunit/UnitTests.xml"
  }
}
