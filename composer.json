    "description": "Frontend Studio - Build, test, and document frontend components in a project-specific styleguide.",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "psr-4": {
            "Andersundsehr\\FrontendStudio\\": "Classes/"
        }
    },
    "authors": [
        {
            "name": "Matthias Vogel",
            "email": "m.vogel@andersundsehr.com"
        }
    ],
    "require": {
        "typo3/cms-core": "^13 || ^14.3.0"
    },
    "extra": {
        "typo3/cms": {
