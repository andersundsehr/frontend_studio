{
  "name": "frontend-studio-development",
  "private": true,
  "workspaces": [
    "Playwright"
  ],
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types --experimental-vm-modules Playwright/**/*.test.{cts,mts,ts} Tests/browser/*.test.{js,cjs,mjs,ts,cts,mts} Tests/browser/*.mjs",
    "test:watch": "node --test --watch --experimental-strip-types --experimental-vm-modules Playwright/**/*.test.{cts,mts,ts} Tests/browser/*.test.{js,cjs,mjs,ts,cts,mts} Tests/browser/*.mjs",
    "typecheck": "tsc --noEmit -p Tests/browser/tsconfig.json",
    "build": "node Build/InlineDocumentationEditor/build.mjs",
    "build:check": "npm run build -- --check"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "linkedom": "0.18.13",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "highlight.js": "11.11.1",
    "lowlight": "3.3.0",
    "lucide": "1.52.0",
    "markdown-it": "14.3.2",
    "turndown": "7.2.2",
    "esbuild": "0.28.2"
  }
}
