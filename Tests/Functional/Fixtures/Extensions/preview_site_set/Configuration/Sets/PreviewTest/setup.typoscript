[site("identifier") == "preview" && siteLanguage("hreflang") == "de" && page == [] && tree.rootLineIds == [] && traverse(request.getQueryParams(), "previewTest") == "yes"]
  page = PAGE
  page.10 = TEXT
  page.10.value = site-set-preview
